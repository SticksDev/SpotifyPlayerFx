{
  "name": "spotify-playerfx",
  "version": "1.0.0",
  "private": true,
  "description": "Winamp-style visualizers behind Spotify's player bar, for Spicetify",
  "type": "module",
  "scripts": {
    "build": "rspack build",
    "watch": "rspack build --watch",
    "typecheck": "tsc --noEmit",
    "install:spicetify": "powershell -NoProfile -ExecutionPolicy Bypass -File ./install.ps1",
    "dist": "npm run build && npm run install:spicetify"
  },
  "devDependencies": {
    "@rspack/cli": "^1.3.0",
    "@rspack/core": "^1.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
